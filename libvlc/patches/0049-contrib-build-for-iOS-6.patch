From 307378dfbd1a5daf8f945f2dc2649950f6deade8 Mon Sep 17 00:00:00 2001
From: Alsey Coleman Miller <alseycmiller@gmail.com>
Date: Thu, 5 Nov 2026 21:03:40 -0500
Subject: [PATCH] contrib: build for iOS 6

- vpx: test the deployment target with the compiler's own macro, as
  SDKs before iOS 10 don't define __IPHONE_10_0 and the timer then used
  clock_gettime(), which they don't have.
- harfbuzz: only enable CoreText from iOS 7, it needs
  CTFontManagerCreateFontDescriptorsFromURL.
- gcrypt: keep the FIPS thread context in a pthread key on targets
  without thread-local storage instead of failing to build.
---
 .../fips-without-thread-local-storage.patch   | 44 +++++++++++++++++++
 contrib/src/gcrypt/rules.mak                  |  2 +
 contrib/src/harfbuzz/rules.mak                |  9 ++++
 ...OCK_MONOTONIC_RAW-in-older-iOS-macOS.patch |  2 +-
 4 files changed, 56 insertions(+), 1 deletion(-)
 create mode 100644 contrib/src/gcrypt/fips-without-thread-local-storage.patch

diff --git a/contrib/src/gcrypt/fips-without-thread-local-storage.patch b/contrib/src/gcrypt/fips-without-thread-local-storage.patch
new file mode 100644
index 0000000000..71fa08b9d1
--- /dev/null
+++ b/contrib/src/gcrypt/fips-without-thread-local-storage.patch
@@ -0,0 +1,44 @@
+--- a/src/fips.c
++++ b/src/fips.c
+@@ -78,6 +78,41 @@
+ static __thread struct gcry_thread_context the_tc = {
+   0, GCRY_FIPS_FLAG_REJECT_DEFAULT
+ };
++#elif defined(HAVE_PTHREAD)
++/* No thread-local storage (e.g. armv7 iOS before 9): keep each thread's
++   context in a pthread key instead.  */
++#include <pthread.h>
++#include <stdlib.h>
++
++static pthread_key_t the_tc_key;
++static pthread_once_t the_tc_once = PTHREAD_ONCE_INIT;
++
++static void
++the_tc_key_create (void)
++{
++  if (pthread_key_create (&the_tc_key, free))
++    abort ();
++}
++
++static struct gcry_thread_context *
++get_the_tc (void)
++{
++  struct gcry_thread_context *tc;
++
++  pthread_once (&the_tc_once, the_tc_key_create);
++  tc = pthread_getspecific (the_tc_key);
++  if (!tc)
++    {
++      tc = malloc (sizeof *tc);
++      if (!tc)
++        abort ();
++      tc->fips_service_indicator = 0;
++      tc->flags_reject_non_fips = GCRY_FIPS_FLAG_REJECT_DEFAULT;
++      pthread_setspecific (the_tc_key, tc);
++    }
++  return tc;
++}
++#define the_tc (*get_the_tc ())
+ #else
+ #error libgcrypt requires thread-local storage to support FIPS mode
+ #endif
diff --git a/contrib/src/gcrypt/rules.mak b/contrib/src/gcrypt/rules.mak
index c89be905f9..99c15aa7ce 100644
--- a/contrib/src/gcrypt/rules.mak
+++ b/contrib/src/gcrypt/rules.mak
@@ -19,6 +19,8 @@ gcrypt: libgcrypt-$(GCRYPT_VERSION).tar.bz2 .sum-gcrypt
 	$(APPLY) $(SRC)/gcrypt/0007-random-don-t-use-API-s-that-are-forbidden-in-UWP-app.patch
 	$(APPLY) $(SRC)/gcrypt/0008-random-only-use-wincrypt-in-UWP-builds-if-WINSTORECO.patch
 	$(APPLY) $(SRC)/gcrypt/0001-hwfeatures-call-SHGetFolderPathA-directly.patch
+	# keep the FIPS thread context in a pthread key where there's no TLS
+	$(APPLY) $(SRC)/gcrypt/fips-without-thread-local-storage.patch
 
 	# don't use getpid in UWP as it's not actually available
 	$(APPLY) $(SRC)/gcrypt/gcrypt-uwp-getpid.patch
diff --git a/contrib/src/harfbuzz/rules.mak b/contrib/src/harfbuzz/rules.mak
index 657ea4511d..91eca38f7d 100644
--- a/contrib/src/harfbuzz/rules.mak
+++ b/contrib/src/harfbuzz/rules.mak
@@ -28,7 +28,16 @@ HARFBUZZ_CONF := -Dfreetype=enabled \
 	-Dgpu_demo=disabled
 
 ifdef HAVE_DARWIN_OS
+ifdef HAVE_IOS
+# hb-coretext needs CTFontManagerCreateFontDescriptorsFromURL (iOS 7)
+ifeq ($(call darwin_min_os_at_least, 7.0), true)
 HARFBUZZ_CONF += -Dcoretext=enabled
+else
+HARFBUZZ_CONF += -Dcoretext=disabled
+endif
+else
+HARFBUZZ_CONF += -Dcoretext=enabled
+endif
 endif
 
 .harfbuzz: harfbuzz crossfile.meson
diff --git a/contrib/src/vpx/0001-do-not-use-CLOCK_MONOTONIC_RAW-in-older-iOS-macOS.patch b/contrib/src/vpx/0001-do-not-use-CLOCK_MONOTONIC_RAW-in-older-iOS-macOS.patch
index a035b520a9..325a1888cc 100644
--- a/contrib/src/vpx/0001-do-not-use-CLOCK_MONOTONIC_RAW-in-older-iOS-macOS.patch
+++ b/contrib/src/vpx/0001-do-not-use-CLOCK_MONOTONIC_RAW-in-older-iOS-macOS.patch
@@ -21,7 +21,7 @@ index 55e7891e1..60141077a 100644
 +#if __APPLE__
 +# include <TargetConditionals.h>
 +# if (TARGET_OS_OSX && defined(__MAC_10_12) && __MAC_OS_X_VERSION_MIN_REQUIRED  < __MAC_10_12) || \
-+     (TARGET_OS_IPHONE && defined(__IPHONE_10_0) && __IPHONE_OS_VERSION_MIN_REQUIRED < __IPHONE_10_0) 
++     (defined(__ENVIRONMENT_IPHONE_OS_VERSION_MIN_REQUIRED__) && __ENVIRONMENT_IPHONE_OS_VERSION_MIN_REQUIRED__ < 100000)
 +   // CLOCK_MONOTONIC_RAW | CLOCK_MONOTONIC require macOS 10.12
 +   // CLOCK_MONOTONIC_RAW | CLOCK_MONOTONIC require iOS 10
 +#  undef CONFIG_OS_SUPPORT
